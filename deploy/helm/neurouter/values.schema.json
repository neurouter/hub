{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["publicUrl", "replicaCount", "migrations"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "publicUrl": { "type": "string", "pattern": "^https://[^/]+(/.*[^/])?$" },
    "migrations": { "type": "object", "properties": { "mode": { "enum": ["onStart", "job"] } } },
    "database": {
      "type": "object",
      "properties": { "url": { "type": "string" }, "existingSecret": { "type": "string" }, "auditUrl": { "type": "string" }, "poolMax": { "type": "integer", "minimum": 1 } }
    },
    "embeddings": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "dtype": { "enum": ["fp32", "fp16", "q8", "q4"] } } },
    "approvals": { "type": "object", "properties": { "maxTimeoutSec": { "type": "integer", "minimum": 60 } } },
    "service": { "type": "object", "properties": { "port": { "type": "integer" } } }
  }
}
