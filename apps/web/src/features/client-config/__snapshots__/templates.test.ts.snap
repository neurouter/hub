// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`client config templates > Claude Code × api_key 1`] = `
{
  "code": "claude mcp add --transport http neurouter https://mcp.acme.example/mcp \\
  --header "Authorization: Bearer \${NEUROUTER_API_KEY}"",
  "hint": "The key is never inserted unless you paste it or just created it. Set NEUROUTER_API_KEY in your environment instead of committing the key.",
  "target": "shell",
  "targetLabel": "Run in your terminal",
}
`;

exports[`client config templates > Claude Code × oauth 1`] = `
{
  "code": "claude mcp add --transport http neurouter https://mcp.acme.example/mcp

# Then run /mcp in Claude Code and choose “Authenticate”.",
  "hint": "Your client will open a browser to approve access. You can revoke it later from the agent’s Authorized apps tab.",
  "target": "shell",
  "targetLabel": "Run in your terminal",
}
`;

exports[`client config templates > Cursor × api_key 1`] = `
{
  "code": "{
  "mcpServers": {
    "neurouter": {
      "url": "https://mcp.acme.example/mcp",
      "headers": {
        "Authorization": "Bearer \${env:NEUROUTER_API_KEY}"
      }
    }
  }
}",
  "hint": "The key is never inserted unless you paste it or just created it. Set NEUROUTER_API_KEY in your environment instead of committing the key.",
  "target": "~/.cursor/mcp.json",
  "targetLabel": "Add to",
}
`;

