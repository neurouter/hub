exports[`client config templates > VS Code × api_key 1`] = `
{
  "code": "{
  "inputs": [
    {
      "type": "promptString",
      "id": "neurouter-key",
      "description": "Neurouter Hub API key",
      "password": true
    }
  ],
  "servers": {
    "neurouter": {
      "type": "http",
      "url": "https://mcp.acme.example/mcp",
      "headers": {
        "Authorization": "Bearer \${input:neurouter-key}"
      }
    }
  }
}",
  "hint": "The key is never inserted unless you paste it or just created it. Set NEUROUTER_API_KEY in your environment instead of committing the key.",
  "target": ".vscode/mcp.json",
  "targetLabel": "Add to",
}
`;

