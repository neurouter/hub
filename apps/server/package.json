{
  "name": "@neurouter/server",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --conditions=@neurouter/source --clear-screen=false src/main.ts",
    "build": "tsc -b",
    "start": "node --max-semi-space-size=16 dist/main.js",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "db:migrate": "tsx --conditions=@neurouter/source src/scripts/migrate.ts",
    "keys": "tsx --conditions=@neurouter/source src/scripts/keys.ts",
    "models:fetch": "tsx --conditions=@neurouter/source src/scripts/fetch-model.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/formbody": "9.0.2",
    "@fastify/helmet": "13.2.0",
    "@fastify/otel": "1.0.1",
    "@fastify/static": "10.1.12",
    "@fastify/swagger": "9.9.5",
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@neurouter/shared": "0.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.2.0",
    "canonicalize": "5.1.0",
    "croner": "11.0.1",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "openid-client": "6.9.1",
    "pg": "8.23.1",
    "pgvector": "0.3.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "prom-client": "15.1.3",
    "sqlite-vec": "0.1.9",
    "undici": "8.13.1",
    "uuidv7": "1.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fastify/cors": "11.4.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
