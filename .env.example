# Neurouter Hub environment. Copy to `.env` (git-ignored) and adjust. In development the server
# loads `.env` from apps/server or the repo root; production reads real environment variables.
# Generate crypto values with:  npm run keys -- gen

# --- core ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Origin users open in the browser. In dev, when you use the UI through Vite, set this to the
# Vite origin (the backend builds OIDC/OAuth redirect URIs and cookies from it, not from Host).
PUBLIC_URL=http://localhost:5173
TRUST_PROXY=loopback
LOG_LEVEL=info
LOG_PRETTY=true
ORG_NAME=Acme Corp

# --- database (SQLite for local dev, no Docker; Postgres in prod) ---
# Relative sqlite paths resolve against the server's working directory (apps/server when run via npm).
DATABASE_URL=sqlite:./data/neurouter.db
# DATABASE_URL=postgres://neurouter:neurouter@localhost:5432/neurouter
# Optional separate database for audit log, sessions and metric rollups (defaults to DATABASE_URL)
AUDIT_DATABASE_URL=
# Optional archive target for audit retention (file:, s3://, gs://, azblob://)
AUDIT_ARCHIVE_URL=
DB_POOL_MAX=20
AUDIT_DB_POOL_MAX=10
MIGRATE_ON_START=true

# --- crypto (required in production; dev falls back to ephemeral values with a warning) ---
NEUROUTER_MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
NEUROUTER_ACTIVE_KEY_ID=k1
HASH_PEPPER=REPLACE_WITH_RANDOM_64_CHARS

# --- human login (OIDC) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISPLAY_NAME=Single sign-on
OIDC_SCOPES=openid email profile groups
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUPS=
OIDC_AUDITOR_GROUPS=
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_GROUP_AUTO_CREATE=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# dev only: email-only login form, no IdP needed (refused unless NODE_ENV=development)
AUTH_DEV_LOGIN=true
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# --- MCP endpoint / OAuth AS ---
MCP_ALLOWED_ORIGINS=
OAUTH_ACCESS_TOKEN_TTL_SEC=3600
OAUTH_REFRESH_TOKEN_TTL_DAYS=30
COORDINATION_BACKEND=auto

# --- embeddings (local model, no external API) ---
EMBEDDINGS_ENABLED=true
EMBEDDINGS_MODEL=onnx-community/granite-embedding-small-english-r2-ONNX
EMBEDDINGS_DTYPE=q8
EMBEDDINGS_DIMS=384
MODELS_DIR=./models
EMBEDDINGS_ALLOW_REMOTE=true

# --- outbound network policy ---
UPSTREAM_ALLOW_PRIVATE_NETWORKS=true
UPSTREAM_DENY_CIDRS=169.254.0.0/16,fd00:ec2::/32
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
OUTBOUND_ALLOW_HTTP_LOOPBACK=true

# --- telemetry ---
METRICS_ENABLED=true
METRICS_TOKEN=
OTEL_SDK_DISABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=neurouter

# --- serving the web app (production) ---
# WEB_DIST_DIR=../web/dist
# SERVE_WEB=true

# --- web dev (apps/web, read by vite.config.ts) ---
# Required for `npm run dev`: where the Vite dev server proxies /api, /mcp, /oauth, /.well-known, /metrics.
NEUROUTER_DEV_API_URL=http://127.0.0.1:3000
# Optional Vite port (Vite's default applies when unset)
NEUROUTER_WEB_DEV_PORT=5173
# Run the UI against MSW mocks instead of a backend
VITE_ENABLE_MSW=false
